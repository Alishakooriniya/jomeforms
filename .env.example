# Frontend configuration (Vite). Copy to `.env.local` and adjust.

# local  → data stays in the browser (local-first default, works offline)
# server → sign-in uses the API in backend/ (see backend/README.md)
VITE_API_MODE=local

# API mount point; the Vite dev server proxies /api to http://127.0.0.1:4000
VITE_API_BASE_URL=/api/v1
