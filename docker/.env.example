# Copy to docker/.env and edit before running:
#   cp docker/.env.example docker/.env
#   docker compose --env-file docker/.env up -d --build
#
# Never commit docker/.env (it is gitignored).

# --- Database ---------------------------------------------------------------
POSTGRES_DB=jomeforms
POSTGRES_USER=jomeforms
POSTGRES_PASSWORD=change-me-to-a-strong-database-password

# --- API secrets ------------------------------------------------------------
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-48-byte-hex-string

# --- Public URLs ------------------------------------------------------------
# The URL users open in the browser. Must match how you reach the web container
# (used for CORS and the same-origin check on the refresh cookie).
PUBLIC_ORIGIN=http://localhost:8080
WEB_PORT=8080
API_PORT=4000

# Set to true when served over HTTPS (recommended for anything but localhost).
COOKIE_SECURE=false

# --- First superadmin (only used by `--profile seed`) -----------------------
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_NAME=مدیر ارشد سامانه
SEED_ADMIN_PASSWORD=

# --- Optional tuning --------------------------------------------------------
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
LOG_LEVEL=info
MAX_UPLOAD_MB=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
