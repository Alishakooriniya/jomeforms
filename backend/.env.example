# Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info
TRUST_PROXY=0

# PostgreSQL (required)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/jomeforms
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Authentication — JWT_SECRET must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-48-byte-hex-string
JWT_EXPIRES_IN=15m
JWT_ISSUER=jomeforms-api
JWT_AUDIENCE=jomeforms-web
REFRESH_TOKEN_TTL_DAYS=7
# Only set this to true when serving over HTTPS (defaults to true in production)
COOKIE_SECURE=false

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploads (scans and workflow evidence)
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_MB=10

# Used only by `npm run db:seed` to create the first superadmin.
# Never commit real values.
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_NAME=مدیر ارشد سامانه
SEED_ADMIN_PASSWORD=
